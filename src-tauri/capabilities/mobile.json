{
  "identifier": "mobile-capability",
  "description": "File converter permissions on Android",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "dialog:default",
    "fs:allow-write-file",
    "fs:allow-read-file"
  ]
}
